{
  "name": "@lapbot/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint src",
    "test": "tsx --test test/core.test.ts test/challenger-m1.test.ts test/admin-and-workflows.test.ts",
    "test:db": "tsx --test test/orders.db.test.ts",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:migrate:prod": "node dist/db/migrate.js",
    "db:seed": "tsx src/db/seed.ts --apply",
    "db:seed:preview": "tsx src/db/seed.ts",
    "admin:create": "tsx src/db/create-admin.ts",
    "admin:create:prod": "node dist/db/create-admin.js"
  },
  "dependencies": {
    "@lapbot/contracts": "0.1.0",
    "dotenv": "16.6.1",
    "fastify": "5.12.7",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@types/node": "24.10.0",
    "@types/pg": "8.15.5",
    "tsx": "4.20.6",
    "typescript": "6.0.3"
  }
}
