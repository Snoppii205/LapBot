{
  "name": "lapbot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm run dev -w @lapbot/api\" \"npm run dev -w @lapbot/web\"",
    "build": "npm run build -w @lapbot/contracts && npm run build -w @lapbot/api && npm run build -w @lapbot/web",
    "start": "npm run start -w @lapbot/api",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "format": "prettier --write \"apps/**/*.{ts,tsx,css,json}\" \"packages/**/*.{ts,json}\" \"e2e/**/*.ts\" \"scripts/**/*.mjs\" \"*.{js,ts,json,md,yaml}\"",
    "format:check": "prettier --check \"apps/**/*.{ts,tsx,css,json}\" \"packages/**/*.{ts,json}\" \"e2e/**/*.ts\" \"scripts/**/*.mjs\" \"*.{js,ts,json,md,yaml}\"",
    "clean": "node -e \"import('node:fs').then(fs=>['packages/contracts/dist','apps/api/dist','apps/web/dist','apps/web/tsconfig.tsbuildinfo'].forEach(p=>fs.rmSync(p,{recursive:true,force:true})))\"",
    "test": "npm run test -w @lapbot/api",
    "test:db": "npm run test:db -w @lapbot/api",
    "e2e": "playwright test",
    "bench:api": "node scripts/bench-api.mjs",
    "db:migrate": "npm run db:migrate --workspace @lapbot/api",
    "db:migrate:prod": "npm run db:migrate:prod --workspace @lapbot/api",
    "db:seed": "npm run db:seed --workspace @lapbot/api",
    "admin:create": "npm run admin:create --workspace @lapbot/api"
  },
  "devDependencies": {
    "concurrently": "9.2.1",
    "eslint": "10.13.0",
    "prettier": "3.5.3",
    "typescript-eslint": "8.71.2"
  }
}
